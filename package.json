{
  "name": "@signalk/node-red-contrib-signalk",
  "version": "1.3.1",
  "description": "Node red nodes to access a Signal K Server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "mocha",
    "build": "tsc && copyfiles -u 1 src/*.html dist/",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "prettier": "prettier --write .",
    "lint": "eslint --fix .",
    "ci-lint": "eslint . && prettier --check .",
    "ci-test": "npm run build && npm run test && npm run ci-lint",
    "format": "npm run prettier && npm run lint",
    "watch": "tsc --watch"
  },
  "author": "Scott Bender",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SignalK/node-red-contrib-signalk"
  },
  "keywords": [
    "node-red"
  ],
  "node-red": {
    "nodes": {
      "signalk-subscribe": "dist/signalk-subscribe.js",
      "signalk-notification": "dist/signalk-notification.js",
      "signalk-flatten-delta": "dist/signalk-flatten-delta.js",
      "signalk-send-pathvalue": "dist/signalk-send-pathvalue.js",
      "signalk-send-delta": "dist/signalk-send-delta.js",
      "signalk-send-notification": "dist/signalk-send-notification.js",
      "signalk-send-put": "dist/signalk-send-put.js",
      "signalk-geofence": "dist/signalk-geofence.js",
      "signalk-geofence-switch": "dist/signalk-geofence-switch.js",
      "signalk-delay": "dist/signalk-delay.js",
      "signalk-put-handler": "dist/signalk-put-handler.js",
      "signalk-put-error": "dist/signalk-put-error.js",
      "signalk-put-success": "dist/signalk-put-success.js",
      "config-client": "dist/config-client.js",
      "signalk-toggle-switch": "dist/signalk-toggle-switch.js",
      "signalk-multi-switch": "dist/signalk-multi-switch.js",
      "signalk-dimmer-switch": "dist/signalk-dimmer-switch.js",
      "signalk-slider-switch": "dist/signalk-slider-switch.js",
      "signalk-app-event": "dist/signalk-app-event.js",
      "signalk-filter-delta": "dist/signalk-filter-delta.js",
      "signalk-get": "dist/signalk-get.js",
      "signalk-input-handler": "dist/signalk-input-handler.js",
      "signalk-input-handler-next": "dist/signalk-input-handler-next.js",
      "signalk-on-delta": "dist/signalk-on-delta.js",
      "signalk-send-nmea0183": "dist/signalk-send-nmea0183.js",
      "signalk-send-nmea2000": "dist/signalk-send-nmea2000.js",
      "signalk-aggregate": "dist/signalk-aggregate.js"
    }
  },
  "dependencies": {
    "@signalk/client": "^2.4.0",
    "@types/node-red": "^1.3.5",
    "geodist": "^0.2.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@signalk/server-api": "^2.25.0",
    "@types/node": "^25.9.1",
    "copyfiles": "^2.4.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "mocha": "^11.0.0",
    "prettier": "^3.6.2",
    "sinon": "^20.0.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
