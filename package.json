{
  "name": "@signalk/node-red-contrib-signalk",
  "version": "1.2.0",
  "description": "Node red nodes for use with external node-red installs",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prettier": "prettier --write .",
    "lint": "eslint --fix .",
    "ci-lint": "eslint . && prettier --check .",
    "format": "npm run prettier && npm run lint"
  },
  "author": "Scott Bender",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SignalK/node-red-contrib-signalk"
  },
  "keywords": [
    "node-red"
  ],
  "node-red": {
    "nodes": {
      "signalk-subscribe": "signalk-subscribe.js",
      "signalk-notification": "signalk-notification.js",
      "signalk-flatten-delta": "signalk-flatten-delta.js",
      "signalk-send-pathvalue": "signalk-send-pathvalue.js",
      "signalk-send-delta": "signalk-send-delta.js",
      "signalk-send-notification": "signalk-send-notification.js",
      "signalk-send-put": "signalk-send-put.js",
      "signalk-geofence": "signalk-geofence.js",
      "signalk-geofence-switch": "signalk-geofence-switch.js",
      "signalk-delay": "signalk-delay.js",
      "signalk-put-handler": "signalk-put-handler.js",
      "signalk-put-error": "signalk-put-error.js",
      "signalk-put-success": "signalk-put-success.js",
      "config-client": "config-client.js",
      "signalk-toggle-switch": "signalk-toggle-switch.js",
      "signalk-multi-switch": "signalk-multi-switch.js",
      "signalk-dimmer-switch": "signalk-dimmer-switch.js",
      "signalk-slider-switch": "signalk-slider-switch.js",
      "signalk-app-event": "signalk-app-event.js",
      "signalk-filter-delta": "signalk-filter-delta.js",
      "signalk-get": "signalk-get.js",
      "signalk-input-handler": "signalk-input-handler.js",
      "signalk-input-handler-next": "signalk-input-handler-next.js",
      "signalk-on-delta": "signalk-on-delta.js",
      "signalk-send-nmea0183": "signalk-send-nmea0183.js",
      "signalk-send-nmea2000": "signalk-send-nmea2000.js"
    }
  },
  "dependencies": {
    "@signalk/client": "^2.4.0",
    "geodist": "^0.2.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  }
